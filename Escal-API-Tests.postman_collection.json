    {
      "name": "METRICS",
      "item": [
        {
          "name": "Get Summary Metrics",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has metrics data\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('revenue');",
                  "    pm.expect(jsonData).to.have.property('net_profit');",
                  "    pm.expect(jsonData).to.have.property('total_ad_spend');",
                  "});",
                  "",
                  "pm.test(\"Response has true_roas and real_profit_after_ads\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('true_roas');",
                  "    pm.expect(jsonData).to.have.property('real_profit_after_ads');",
                  "});",
                  "",
                  "pm.test(\"Metrics are non-negative\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.revenue).to.be.at.least(0);",
                  "    pm.expect(jsonData.total_ad_spend).to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test(\"True ROAS calculation is correct\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    if (jsonData.total_ad_spend > 0) {",
                  "        var expectedRoas = Math.round((jsonData.revenue / jsonData.total_ad_spend) * 100) / 100;",
                  "        pm.expect(jsonData.true_roas).to.equal(expectedRoas);",
                  "    }",
                  "});"
                ]
              }
            }
          ],
