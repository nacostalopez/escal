  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Set base URL",
          "if (!pm.environment.get('base_url')) {",
          "    pm.environment.set('base_url', 'http://localhost:8000');",
          "}",
          "",
          "// Set default date range (last 30 days)",
          "if (!pm.environment.get('range_start')) {",
          "    let now = new Date();",
          "    let start = new Date(now.getTime() - 30*24*60*60*1000);",
          "    pm.environment.set('range_start', start.toISOString());",
          "    pm.environment.set('range_end', now.toISOString());",
          "}"
        ]
      }
    }
  ]
}
